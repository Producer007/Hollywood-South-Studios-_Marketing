# HEDERA TESTNET credentials only. Copy to hedera/.env and fill in. Never commit .env.
# Get an account at https://portal.hedera.com (testnet).
#
# If you already have hedera/.env for the GCN connection check, HEDERA_OPERATOR_ID and
# HEDERA_OPERATOR_KEY from that file are accepted too; you can copy it here as-is.

HEDERA_TESTNET_ACCOUNT_ID=0.0.10717267
HEDERA_TESTNET_PRIVATE_KEY=
# Raw 64-hex keys are ambiguous; say which kind. GCN's operator is ECDSA (it has an EVM alias).
# DER keys (302e.../3030...) are self-describing and ignore this.
HEDERA_KEY_TYPE=ECDSA

# Optional
# HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
# HEDERA_STATE_PATH=./state.json
