+++ b/test/AtomicSwapV2.settlement.test.js
@@ -0,0 +1,160 @@
+// Regression tests for the pre-audit settlement fixes (26 Sep 2026), run against both
+// AtomicSwapV2_Hedera and AtomicSwapV2_Eth. F1–F4 name the findings each test guards.
+const { expect } = require("chai");
+const { ethers, network } = require("hardhat");
+
+const ONE = ethers.parseEther("1");
+const bal = (a) => ethers.provider.getBalance(a);
+
+async function expectRevert(promise, reason) {
+  try {
+    await promise;
+  } catch (e) {
+    // Hardhat can't always infer the reason (viaIR source maps); decode Error(string) data too.
+    let decoded = "";
+    const data = e.data?.data ?? e.data;
+    if (typeof data === "string" && data.startsWith("0x08c379a0")) {
+      decoded = ethers.AbiCoder.defaultAbiCoder().decode(["string"], "0x" + data.slice(10))[0];
+    }
+    expect(`${e.message} ${decoded}`).to.include(reason);
+    return;
+  }
+  throw new Error(`expected revert "${reason}"`);
+}
+
+async function passTime(s) {
+  await network.provider.send("evm_increaseTime", [s]);
+  await network.provider.send("evm_mine");
+}
+
+function newSecret() {
+  const secret = ethers.hexlify(ethers.randomBytes(32));
+  return { secret, lock: ethers.sha256(secret) };
+}
+
+for (const name of ["AtomicSwapV2_Hedera", "AtomicSwapV2_Eth"]) {
+  describe(`${name} — settlement`, () => {
+    let swap, addr, admin, alice, bob, mallory, mallory2, cb;
+
+    beforeEach(async () => {
+      [admin, alice, bob, mallory, mallory2, cb] = await ethers.getSigners();
+      swap = await (await ethers.getContractFactory(name)).deploy(ethers.ZeroAddress);
+      addr = await swap.getAddress();
+    });
+
+    async function create(from, counterparty, initAmt, cpAmt, lock, { ttl = 3600, initAsset = ethers.ZeroAddress, cpAsset = ethers.ZeroAddress, value } = {}) {
+      const expiry = (await ethers.provider.getBlock("latest")).timestamp + ttl;
