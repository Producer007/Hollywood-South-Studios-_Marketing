diff --git a/scripts/deploy-hedera.js b/scripts/deploy-hedera.js
new file mode 100644
index 0000000..20c0d4c
--- /dev/null
+++ b/scripts/deploy-hedera.js
@@ -0,0 +1,78 @@
+// Deploys AtomicSwapV2_Hedera to Hedera TESTNET and records the result in
+// deployments/hedera-testnet.json. Pre-audit: testnet only, not for live value.
+//
+//   npm run deploy:hedera-testnet
+//
+// Env: HEDERA_PRIVATE_KEY (ECDSA, hex), optional CARBON_NFT_ADDRESS (defaults to
+// address(0): carbon minting disabled until setCarbonCreditNFT is called).
+const fs = require("fs");
+const path = require("path");
+const { execSync } = require("child_process");
+const hre = require("hardhat");
+
+const MIRROR = "https://testnet.mirrornode.hedera.com";
+
+async function mirrorContractId(evmAddress) {
+  // The mirror node lags consensus by a few seconds.
+  for (let i = 0; i < 20; i++) {
+    const res = await fetch(`${MIRROR}/api/v1/contracts/${evmAddress}`);
+    if (res.ok) return (await res.json()).contract_id;
+    await new Promise((r) => setTimeout(r, 3000));
+  }
+  return null;
+}
+
+async function main() {
+  const { ethers, network } = hre;
+  const chainId = Number((await ethers.provider.getNetwork()).chainId);
+  if (network.name !== "hederaTestnet" || chainId !== 296) {
+    throw new Error(`Refusing to deploy: network "${network.name}" (chainId ${chainId}). This engine is pre-audit and deploys to hederaTestnet (296) only.`);
+  }
+  const [deployer] = await ethers.getSigners();
+  if (!deployer) throw new Error("HEDERA_PRIVATE_KEY is not set in .env");
+
+  const nft = process.env.CARBON_NFT_ADDRESS || ethers.ZeroAddress;
+  console.log(`Deployer  ${deployer.address}  balance ${ethers.formatEther(await ethers.provider.getBalance(deployer.address))} HBAR`);
+  console.log(`Carbon NFT ${nft === ethers.ZeroAddress ? "not configured (address(0))" : nft}`);
+
+  const swap = await (await ethers.getContractFactory("AtomicSwapV2_Hedera")).deploy(nft);
+  const tx = swap.deploymentTransaction();
+  console.log(`Deploy tx  ${tx.hash}`);
+  await swap.waitForDeployment();
+  const evmAddress = await swap.getAddress();
+  console.log(`Deployed   ${evmAddress}`);
+
+  const contractId = await mirrorContractId(evmAddress);
+  console.log(`Contract ID ${contractId ?? "not yet on the mirror node — look it up by EVM address later"}`);
+
+  let gitCommit = null;
+  try {
+    gitCommit = execSync("git rev-parse --short HEAD", { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
+  } catch {}
+
+  const record = {
+    contract: "AtomicSwapV2_Hedera",
+    status: "Pre-audit · Testnet only · Not deployed for live value",
+    network: "hedera-testnet",
+    chainId,
+    contractId,
+    evmAddress,
+    deployer: deployer.address,
+    deployTx: tx.hash,
+    carbonCreditNFT: nft,
+    solc: "0.8.19",
+    openzeppelin: "4.9.6",
+    gitCommit,
+    deployedAt: new Date().toISOString(),
+  };
+  const dir = path.join(__dirname, "..", "deployments");
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, "hedera-testnet.json"), JSON.stringify(record, null, 2) + "\n");
+  console.log(`\nRecorded in deployments/hedera-testnet.json`);
+  if (contractId) console.log(`For the Hedera connection check: HEDERA_CONTRACT_IDS=AtomicSwapV2_Hedera=${contractId}`);
+}
+
+main().catch((e) => {
+  console.error(e.message ?? e);
+  process.exitCode = 1;
+});
diff --git a/scripts/smoke-hedera.js b/scripts/smoke-hedera.js
new file mode 100644
index 0000000..e5332c2
--- /dev/null
+++ b/scripts/smoke-hedera.js
@@ -0,0 +1,52 @@
+// Runs one simulated test swap against the deployed testnet contract:
+// create → fund → withdraw (both legs settle) → check the contract holds nothing for it.
+// The deployer plays both parties, so only gas is spent. Testnet only.
+//
+//   npm run smoke:hedera-testnet
+const fs = require("fs");
+const path = require("path");
+const hre = require("hardhat");
+
+async function main() {
+  const { ethers, network } = hre;
+  const chainId = Number((await ethers.provider.getNetwork()).chainId);
+  const onHedera = chainId === 296;
+  if (network.name !== "hardhat" && !onHedera) throw new Error(`Refusing: network "${network.name}" (chainId ${chainId}) is not hederaTestnet or local hardhat.`);
+  const [me] = await ethers.getSigners();
+
+  let swap;
+  if (onHedera) {
+    const rec = JSON.parse(fs.readFileSync(path.join(__dirname, "..", "deployments", "hedera-testnet.json"), "utf8"));
+    swap = await ethers.getContractAt("AtomicSwapV2_Hedera", rec.evmAddress);
+    console.log(`Contract   ${rec.contractId ?? ""} ${rec.evmAddress}`);
+  } else {
+    swap = await (await ethers.getContractFactory("AtomicSwapV2_Hedera")).deploy(ethers.ZeroAddress);
+    console.log(`Contract   local ${await swap.getAddress()}`);
+  }
+
+  // Inside the Hedera EVM msg.value is tinybars (8 decimals); the relay takes weibars (18).
+  const value = ethers.parseEther("0.01"); // 0.01 HBAR sent per leg
+  const amount = onHedera ? value / 10n ** 10n : value; // 1,000,000 tinybars on Hedera
+  const secret = ethers.hexlify(ethers.randomBytes(32));
+  const expiry = Math.floor(Date.now() / 1000) + 3600;
+  const addr = await swap.getAddress();
+  const before = await ethers.provider.getBalance(addr);
+
+  const rc = await (await swap.createSwap(me.address, ethers.ZeroAddress, ethers.ZeroAddress, amount, amount, ethers.sha256(secret), expiry, { value })).wait();
+  const id = rc.logs.map((l) => { try { return swap.interface.parseLog(l); } catch { return null; } }).find((e) => e?.name === "SwapCreated").args.swapId;
+  console.log(`1 created   ${id}  tx ${rc.hash}`);
+  console.log(`2 funded    tx ${(await (await swap.fundSwap(id, { value })).wait()).hash}`);
+  console.log(`3 withdrawn tx ${(await (await swap.withdraw(id, secret)).wait()).hash}`);
+
+  const s = await swap.swaps(id);
+  const after = await ethers.provider.getBalance(addr);
+  const ok = s.withdrawn && s.funded && after === before;
+  console.log(`4 settled=${s.withdrawn} funded=${s.funded}; contract balance ${ethers.formatEther(before)} → ${ethers.formatEther(after)} HBAR`);
+  console.log(ok ? "\nTEST SWAP PASSED (simulated · testnet)" : "\nTEST SWAP FAILED");
+  if (!ok) process.exitCode = 1;
+}
+
+main().catch((e) => {
+  console.error(e.message ?? e);
+  process.exitCode = 1;
+});
diff --git a/test/AtomicSwapV2.settlement.test.js b/test/AtomicSwapV2.settlement.test.js
