# Copy to .env and fill in from https://portal.hedera.com/dashboard
# Never commit .env.

# testnet | previewnet | mainnet  (portal.hedera.com issues testnet/previewnet accounts)
HEDERA_NETWORK=testnet

# GCN testnet account from the portal dashboard (public identifiers; safe to commit)
HEDERA_OPERATOR_ID=0.0.10716121
HEDERA_OPERATOR_EVM=0xd1d8734c645392df255d98287c645592407a3e23

# Private key from the portal dashboard. NEVER commit it or paste it into chat.
# This account has an ECDSA alias EVM address, so expect the HEX key (0x + 64 hex) or DER (3030...).
HEDERA_OPERATOR_KEY=

# Optional: contract / HTS token IDs to verify on the mirror node (Name=0.0.x, comma-separated).
# A contract is only labelled "Testnet Deployed" in page copy when it resolves here.
# HEDERA_CONTRACT_IDS=GCNAtomicSwapV2=0.0.,IoTOracle_Hedera=0.0.
# HEDERA_TOKEN_IDS=GOLD_TEST=0.0.

# Optional overrides
# HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
# HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
